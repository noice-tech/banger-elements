---
import Showcase from '../layouts/Showcase.astro';
import Preview from '../components/Preview';
import type {PreviewKind} from '../components/Preview';
import GitHubIcon from '../components/GitHubIcon.astro';
import {elements, elementCategories} from '../data/elements';
import {previewDurationInSeconds} from '../components/preview/player';
import {highlightCode} from '../components/highlight';
import {elementPayloadHtml, elementPayloadMimeType} from '../data/element-payloads';
export function getStaticPaths() {
	return elements.map(entry => ({params: {element: entry.slug}, props: {entry}}));
}
const {entry} = Astro.props;
const isWrapper = entry.category === 'effects';
const wrapperName = entry.name;
const bypassKey = entry.slug === 'wet-glass' ? 'amount' : 'strength';
const bypassValues: Record<string, number> = {'wet-glass': 0.65, vhs: 1};
const wrapperExample = `import {${wrapperName}} from './${entry.slug}.element';
import {Space} from './space.element';
import {Halo} from './halo.element';

// Install Space and Halo separately, or use your existing content.
<${wrapperName} width={1280} height={720} ${bypassKey}={${bypassValues[entry.slug] ?? 0.75}}>
  <Space playAudio={false} style={{position: 'absolute', inset: 0}} />
  <Halo playAudio style={{position: 'absolute', inset: 0}} />
</${wrapperName}>`;
const category = elementCategories.find(category => category.id === entry.category)!;
const featured: readonly string[] = category.featured;
const rank = (slug: string) => (featured.includes(slug) ? featured.indexOf(slug) : featured.length);
const siblings = elements.filter(element => element.category === entry.category).sort((a, b) => rank(a.slug) - rank(b.slug));
const position = siblings.findIndex(element => element.slug === entry.slug);
const next = siblings.length > 1 ? siblings[(position + 1) % siblings.length]! : elements.find(element => element.slug !== entry.slug)!;
const duration = previewDurationInSeconds(entry.slug as PreviewKind);
---
<Showcase title={entry.title} description={entry.description} pageClass="page-element" searchable image={`/share/${entry.slug}.jpg`} imageAlt={`${entry.title}: ${entry.tagline}`} markdown={`/${entry.slug}.md`}>
	<link slot="head" rel="alternate" type="application/vnd.remotion.element+json" href={`/elements/${entry.slug}.json`} />
	<div class="wrap wrap-wide">
		<header class="element-head">
			<nav class="kicker" aria-label="Breadcrumb"><a href="/#collection">Collection</a><span aria-hidden="true">/</span><a href={`/${category.id}`}>{category.title}</a><span aria-hidden="true">/</span><span aria-current="page">{entry.title}</span></nav>
			<div class="element-head-row">
				<div>
					<h1 id="_top">{entry.title}</h1>
					<p class="element-tagline">{entry.tagline}</p>
				</div>
				<ul class="tags" aria-label="Details">
					<li>{category.title}</li>
					<li>{entry.renderer}</li>
					<li>60 fps</li>
				</ul>
			</div>
		</header>
		<div class="element-workbench">
			<div class="element-preview">
				<Preview slug={entry.slug as PreviewKind} editable installTargetId={`${entry.slug}-studio-actions`} controlsTargetId={`${entry.slug}-preview-controls`} client:only="react">
					<div slot="fallback" class="preview-block">
						<div class="preview-stage"><div class="preview-placeholder" role="status" aria-label="Loading preview"></div></div>
						<div class="preview-caption" aria-hidden="true">
							<span>60 FPS · {duration} seconds · Press play to hear audio</span>
							<span>{isWrapper ? 'Demo children are not included. Wrap your own JSX after installation.' : 'Studio uses your preview settings. Download TSX uses the original defaults.'}</span>
						</div>
					</div>
				</Preview>
				<section class="preview-install" aria-label={`${entry.title} installation`}>
					<script type={elementPayloadMimeType} set:html={elementPayloadHtml(entry.slug)} />
					<div id={`${entry.slug}-studio-actions`}></div>
					<div class="source-links">
						<a href={`/elements/${entry.slug}.tsx`} download={`${entry.slug}.element.tsx`}>Download TSX <span aria-hidden="true">↓</span></a>
						<a href={`https://github.com/noice-tech/banger-elements/blob/main/packages/elements/src/elements/${entry.slug}/${entry.slug}.tsx`} target="_blank" rel="noreferrer"><GitHubIcon /> Source</a>
					</div>
					<p class="install-note">{isWrapper ? `Installs the wrapper only, not the demo. After confirming in Studio, move your existing JSX inside <${wrapperName}> in code. Inserting it as a sibling does not apply the effect.` : 'Install or drag to use your preview settings. Confirm the request in Studio.'}</p>
					<details class="install-help"><summary>Need help connecting?</summary><p>Open a composition in a compatible Remotion Studio first. Install and drag both require confirmation. On touch devices, use Install in Studio. You can also <a href="/getting-started.html#install-from-the-command-line">install from the command line</a>.</p></details>
				</section>
			</div>
			<aside class="element-config" aria-label={`${entry.title} preview settings`}>
				<div id={`${entry.slug}-preview-controls`} class="controls-slot"></div>
			</aside>
		</div>
	</div>

	<div class="wrap element-docs">
		<p class="element-description">{entry.description}</p>
		<div class="prose">
			<h2 id="after-installation">After installation</h2>
			{isWrapper ? <>
				<p>Download the TSX or confirm installation in Studio, then wrap the Elements you want to affect in <code>&lt;{wrapperName}&gt;…&lt;/{wrapperName}&gt;</code>. The wrapper is empty until you add children; it does not automatically wrap selected layers. The preview's visualizers and title are demo content, not bundled dependencies.</p>
				<pre><code set:html={highlightCode(wrapperExample)} /></pre>
				<p>Match child dimensions to the wrapper and position stacked layers absolutely. Each Element keeps its own Sequence; moving the wrapper moves the group. Select the wrapper in Studio for effect controls. Set <code>{bypassKey}</code> to zero for a clean bypass.</p>
			</> : <>
				<p>The Studio protocol handles source installation and insertion, so this workflow does not require a manual import. Confirm the request in Studio, then select the inserted Element to adjust its Interactive controls.</p>
				<p>No props are required. With the demo track, Studio copies it to <code>public/banger-elements/</code> so the Element plays offline. With your own track, the installed source uses the audio URL from your preview. Local files need a hosted URL before installation. See <a href="/getting-started.html#audio-setup">audio setup</a> to use your own track, or copy the configured JSX from the preview controls for use with the original source.</p>
				{entry.category === 'shaders' && <p>{entry.title} fills the composition you install it into, at any aspect ratio. If you change the preview's width or height, the installed Element keeps that fixed size instead.</p>}
			</>}
			<details class="reference-section" open><summary><h2 id="controls">Key controls</h2></summary><ul>{entry.controls.map(control => <li>{control}</li>)}</ul>{isWrapper ? <p>{entry.title} exposes size and transform controls, but no audio controls. The Demo audio tab changes only the preview children. Copy configured JSX to reuse your effect settings around your own content.</p> : <p>Visualizers and shaders expose <code>audioSrc</code>, <code>audioOffsetInSeconds</code>, <code>playAudio</code>, <code>inputGainDb</code>, <code>width</code> and <code>height</code>. Select the Element itself in Studio to see its Interactive controls.</p>}</details>
			<details class="reference-section" open><summary><h2 id="limitations">Before you render</h2></summary><aside class="limitation">{entry.limitation}</aside>{entry.renderer === 'WebGL2' && <p>Depending on your rendering environment, you may need to enable ANGLE when rendering with Remotion. If the element renders blank or reports a WebGL error, try adding <code>--gl=angle</code> to your <code>remotion render</code> command. See <a href="/getting-started.html#rendering-with-angle">Rendering with ANGLE</a>.</p>}{isWrapper ? <p>{entry.title} does not play or analyze audio. Enable audio on only one child when stacking visualizers. Child motion remains driven by Remotion's timeline.</p> : <p>Playback is enabled by default. Stacking elements? Enable only one audio track. Analysis gain affects visuals, not playback volume. Each instance decodes its own fixed audio windows, so stacked instances use more memory.</p>}</details>
		</div>
	</div>

	<section class="wrap element-next" aria-labelledby="next-title">
		<a class="next-card" href={`/${next.slug}.html`}>
			<video muted loop playsinline preload="none" poster={`/posters/${next.slug}.webp`} aria-hidden="true" data-play-visible>
				<source src={`/previews/${next.slug}.webm`} type="video/webm" />
			</video>
			<span class="tile-shade" aria-hidden="true"></span>
			<span class="next-copy">
				<span class="kicker" id="next-title">Up next</span>
				<span class="next-title">{next.title} <span aria-hidden="true">→</span></span>
				<span class="next-tagline">{next.tagline}</span>
			</span>
		</a>
		<div class="sibling-strip">
			<p class="kicker">All {category.title.toLowerCase()}</p>
			<ul>
				{siblings.map(element => (
					<li>
						<a href={`/${element.slug}.html`} aria-current={element.slug === entry.slug ? 'page' : undefined}>
							<img src={`/posters/${element.slug}.webp`} alt="" width="96" height="54" loading="lazy" decoding="async" />
							<span>{element.title}</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</Showcase>
