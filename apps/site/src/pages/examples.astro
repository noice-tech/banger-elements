---
import Showcase from '../layouts/Showcase.astro';
import {elements} from '../data/elements';
import {highlightLine} from '../components/highlight';
import {DEMO_SONG, RECIPE_FPS, recipes} from '../components/recipes/recipes';
import episodeClip from '../components/recipes/episode-clip.tsx?raw';
import lyricVideo from '../components/recipes/lyric-video.tsx?raw';
import musicVisualizer from '../components/recipes/music-visualizer.tsx?raw';
import releaseReel from '../components/recipes/release-reel.tsx?raw';
import releaseTeaser from '../components/recipes/release-teaser.tsx?raw';
import verticalCanvas from '../components/recipes/vertical-canvas.tsx?raw';
import rainyStream from '../components/recipes/rainy-stream.tsx?raw';

const sources: Record<string, string> = {
	'episode-clip': episodeClip,
	'lyric-video': lyricVideo,
	'music-visualizer': musicVisualizer,
	'release-teaser': releaseTeaser,
	'release-reel': releaseReel,
	'vertical-canvas': verticalCanvas,
	'rainy-stream': rainyStream,
};
const element = (slug: string) => elements.find((entry) => entry.slug === slug)!;
const byName = new Map(elements.map((entry) => [entry.name, entry.slug]));

// The recipes import the collection's build for rendering. Readers install each
// element as its own file, so show one import per element instead.
const forReaders = (source: string) =>
	source.replace(/^import \{([^}]+)\} from '[^']*packages\/elements\/dist\/components';$/m, (_, names: string) =>
		names
			.split(',')
			.map((name) => name.trim())
			.map((name) => `import {${name}} from './${byName.get(name)}.element';`)
			.join('\n'),
	);

const shapeOf = (width: number, height: number) => (width === height ? 'square' : width > height ? 'wide' : 'tall');
const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;

const cards = recipes.map((recipe) => {
	const code = forReaders(sources[recipe.id]!).trimEnd();
	const scale = recipe.outputScale ?? 1;
	const seconds = recipe.durationInFrames / RECIPE_FPS;
	const flags = [
		'--gl=angle',
		...(scale === 1 ? [] : [`--scale=${scale}`]),
		...(recipe.silent ? ['--codec=h264', '--muted'] : []),
	];
	return {
		...recipe,
		shape: shapeOf(recipe.width, recipe.height),
		format: `${recipe.width * scale} × ${recipe.height * scale}`,
		seconds,
		length: `${Number(seconds.toFixed(1))} s`,
		command: `npx remotion render ${recipe.component} ${flags.join(' ')}`,
		audio: recipe.audioFile ? `/${recipe.audioFile}` : DEMO_SONG,
		lines: code.split('\n').map(highlightLine),
		layerEntries: recipe.layers.map(element),
	};
});
---
<Showcase
	title="Examples"
	description="Seven Remotion compositions made with Banger Elements: a lyric video, a music visualizer, a release trailer, a work-in-progress reel, a Spotify Canvas, a podcast clip and a lo-fi stream background. Each one comes with the code that rendered it."
	pageClass="page-examples"
>
	<div class="wrap">
		<header class="page-hero">
			<nav class="kicker" aria-label="Breadcrumb"><a href="/getting-started.html">Docs</a><span aria-hidden="true">/</span><span aria-current="page">Examples</span><span class="kicker-count">{recipes.length}</span></nav>
			<h1>Built from <span class="tone">the collection.</span></h1>
			<p class="lede">
				Each of these seven Remotion compositions matches the size its platform expects. Under each clip is the file that
				rendered it. Replace the audio and the text, then render your own.
			</p>
		</header>

		<nav class="recipe-index" aria-label="Examples on this page">
			{cards.map((card) => (
				<a href={`#${card.id}`}>
					<img src={`/recipes/${card.id}.webp`} alt="" loading="lazy" decoding="async" />
					<span>{card.title}</span>
				</a>
			))}
		</nav>

		{cards.map((card) => (
			<article class="recipe" id={card.id} data-shape={card.shape} aria-labelledby={`${card.id}-title`}>
				<div class="recipe-player" style={`--ratio: ${card.width} / ${card.height}`} data-player>
					<video muted loop playsinline preload="none" poster={`/recipes/${card.id}.webp`} data-play-visible>
						<source src={`/recipes/${card.id}.webm`} type="video/webm" />
					</video>
					<div class="player-bar">
						<button class="player-button" type="button" aria-label="Play" data-player-toggle>
							<svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8v10.4a.6.6 0 0 0 .9.5l8.2-5.2a.6.6 0 0 0 0-1L5.4 2.3a.6.6 0 0 0-.9.5z" fill="currentColor"></path></svg>
							<svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="2.5" width="3" height="11" rx="0.8" fill="currentColor"></rect><rect x="9.5" y="2.5" width="3" height="11" rx="0.8" fill="currentColor"></rect></svg>
						</button>
						<input class="player-seek" type="range" min="0" max={card.seconds} step="any" value="0" aria-label={`Seek ${card.title}`} data-player-seek />
						<span class="player-time" aria-hidden="true" data-player-time>0:00 / {clock(card.seconds)}</span>
						{!card.silent && <button class="player-button" type="button" aria-pressed="false" data-recipe-sound>
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path d="M2 6h2.5L8 3v10L4.5 10H2z" fill="currentColor"></path>
								<path class="sound-waves" d="M10.5 5.5a3.5 3.5 0 0 1 0 5M12.5 3.5a6.3 6.3 0 0 1 0 9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
								<path class="sound-muted" d="m10.5 6 4 4m0-4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
							</svg>
							<span class="sr-only">Sound</span>
						</button>}
					</div>
				</div>
				<div class="recipe-body">
					<p class="recipe-use">{card.use}</p>
					<h2 id={`${card.id}-title`}>{card.title}</h2>
					<p class="recipe-description">{card.description}</p>
					<p class="recipe-facts">
						<span>{card.format}</span><span>{card.length}</span><span>{RECIPE_FPS} fps</span>
					</p>
					<p class="recipe-layers-label">Layers, back to front</p>
					<ol class="recipe-layers">
						{card.layerEntries.map((entry) => (
							<li>
								<a href={`/${entry.slug}.html`}>
									<img src={`/posters/${entry.slug}.webp`} alt="" loading="lazy" decoding="async" />
									{entry.title}
								</a>
							</li>
						))}
					</ol>
					{card.audioCredit && <p class="recipe-credit">
						Music: <a href={card.audioCredit.source}>{card.audioCredit.title}</a> by {card.audioCredit.artist},
						<a href={card.audioCredit.licenseUrl}>{card.audioCredit.license}</a>
					</p>}
				</div>
				<details class="recipe-code code-window">
					<summary class="code-window-bar">
						<span class="code-file"><span class="code-dir">src/</span>{card.component}.tsx</span>
						<span class="recipe-code-meta"><span class="recipe-code-count">{card.lines.length} lines</span><span class="recipe-code-toggle" aria-hidden="true"></span></span>
					</summary>
					<div class="recipe-code-actions">
						<code><span aria-hidden="true">$ </span>{card.command}</code>
						<span class="recipe-code-buttons">
							<a class="code-copy" href={card.audio} download>Download audio</a>
							<button type="button" class="code-copy" data-copy-recipe>Copy code</button>
						</span>
					</div>
<pre class="code-lines"><code>{card.lines.map((html) => <span class="line" set:html={html} />)}</code></pre>
				</details>
			</article>
		))}

	</div>
</Showcase>
<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-recipe]')) {
		const lines = button.closest('details')!.querySelectorAll('.line');
		let reset: number | undefined;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(Array.from(lines, (line) => line.textContent).join('\n'));
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Select to copy';
			}
			window.clearTimeout(reset);
			reset = window.setTimeout(() => (button.textContent = 'Copy code'), 1600);
		});
	}

	const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
	const sounds: {button: HTMLButtonElement; video: HTMLVideoElement}[] = [];

	for (const player of document.querySelectorAll<HTMLElement>('[data-player]')) {
		const video = player.querySelector('video')!;
		const toggle = player.querySelector<HTMLButtonElement>('[data-player-toggle]')!;
		const seek = player.querySelector<HTMLInputElement>('[data-player-seek]')!;
		const time = player.querySelector<HTMLElement>('[data-player-time]')!;
		const total = Number(seek.max);
		let raf = 0;

		const paint = () => {
			const at = Math.min(video.currentTime, total);
			seek.value = String(at);
			seek.style.setProperty('--progress', String(at / total));
			seek.setAttribute('aria-valuetext', `${clock(at)} of ${clock(total)}`);
			time.textContent = `${clock(at)} / ${clock(total)}`;
		};
		const tick = () => {
			paint();
			raf = requestAnimationFrame(tick);
		};

		// The page plays clips while they are on screen. Pausing one takes it out of
		// that until it is played again, so it stays where it was left.
		const play = () => {
			if (!motion.matches) video.toggleAttribute('data-play-visible', true);
			void video.play().catch(() => {});
		};
		const pause = () => {
			video.removeAttribute('data-play-visible');
			video.pause();
		};
		const flip = () => (video.paused ? play() : pause());

		video.addEventListener('play', () => {
			player.toggleAttribute('data-playing', true);
			toggle.setAttribute('aria-label', 'Pause');
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(tick);
		});
		video.addEventListener('pause', () => {
			player.toggleAttribute('data-playing', false);
			toggle.setAttribute('aria-label', 'Play');
			cancelAnimationFrame(raf);
			paint();
		});
		toggle.addEventListener('click', flip);
		video.addEventListener('click', flip);
		seek.addEventListener('input', () => {
			video.currentTime = Number(seek.value);
			paint();
		});

		const sound = player.querySelector<HTMLButtonElement>('[data-recipe-sound]');
		if (!sound) continue;
		sounds.push({button: sound, video});
		// One clip plays sound at a time. Turning it on is a request to hear it, even under reduced motion.
		sound.addEventListener('click', () => {
			const on = video.muted;
			for (const other of sounds) {
				other.video.muted = true;
				other.button.setAttribute('aria-pressed', 'false');
			}
			video.muted = !on;
			sound.setAttribute('aria-pressed', String(on));
			if (on && video.paused) play();
		});
	}
</script>
