---
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import StudioActions from './StudioActions';
---
<div class="header-studio-actions">
	<StudioActions client:only="react" />
</div>
<SocialIcons />

<style>
	.header-studio-actions {
		position: relative;
	}
	.header-studio-actions :global(.actions) {
		margin: 0;
		flex-wrap: nowrap;
	}
	.header-studio-actions :global(button) {
		min-height: 34px;
		padding: 0 0.95rem;
		font-size: 0.82rem;
		white-space: nowrap;
	}
	.header-studio-actions :global([role='status']:not(:empty)) {
		position: absolute;
		top: 100%;
		right: 0;
		width: min(22rem, calc(100vw - 2rem));
		padding: 0.9rem 1rem;
		border-radius: var(--radius);
		background: var(--surface-2);
		color: var(--text);
		box-shadow: var(--shadow-raised);
	}
</style>
