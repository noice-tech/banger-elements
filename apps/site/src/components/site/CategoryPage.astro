---
import Showcase from '../../layouts/Showcase.astro';
import Collection from '../Collection.astro';
import {elements, elementCategories} from '../../data/elements';

interface Props {
	category: (typeof elementCategories)[number]['id'];
}
const category = elementCategories.find((entry) => entry.id === Astro.props.category)!;
const count = elements.filter((entry) => entry.category === category.id).length;
const description = `${category.description} Explore open-source ${category.title.toLowerCase()} for Remotion, preview and customize each element, and use the source in your project.`;
---
<Showcase title={`${category.title} for Remotion`} description={description} pageClass="page-category">
	<div class="wrap">
		<header class="page-hero">
			<nav class="kicker" aria-label="Breadcrumb"><a href="/#collection">Collection</a><span aria-hidden="true">/</span><span aria-current="page">{category.title}</span><span class="kicker-count">{count}</span></nav>
			<h1>{category.title} <span class="tone">for Remotion.</span></h1>
			<p class="lede">{category.description} Preview each one live, tune it, and make the source your own.</p>
		</header>
		<Collection category={category.id} />
	</div>
</Showcase>
