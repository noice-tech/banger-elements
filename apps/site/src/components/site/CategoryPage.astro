---
import Showcase from '../../layouts/Showcase.astro';
import Collection from '../Collection.astro';
import {elementCategories} from '../../data/elements';

interface Props {
	category: (typeof elementCategories)[number]['id'];
}
const category = elementCategories.find((entry) => entry.id === Astro.props.category)!;
const description = `${category.description} Open one to play it and change its settings, then add it to Remotion Studio.`;
---
<Showcase title={`${category.title} for Remotion`} description={description} pageClass="page-category" image={`/share/${category.id}.jpg`} imageAlt={`A grid of Banger Elements ${category.title.toLowerCase()}`} markdown={`/${category.id}.md`}>
	<div class="wrap">
		<header class="page-hero">
			<nav class="kicker" aria-label="Breadcrumb"><a href="/#collection">Collection</a><span aria-hidden="true">/</span><span aria-current="page">{category.title}</span></nav>
			<h1>{category.title} <span class="tone">for Remotion.</span></h1>
			<p class="lede">{category.description} Open one to play it and change its settings.</p>
		</header>
		<Collection category={category.id} />
	</div>
</Showcase>
