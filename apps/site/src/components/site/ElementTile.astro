---
interface Props {
	slug: string;
	title: string;
	tagline: string;
	description: string;
}
const {slug, title, tagline, description} = Astro.props;
---
<div class="tile-item" data-slug={slug} data-search={`${title} ${tagline} ${description}`.toLowerCase()}>
	<a class="tile" href={`/${slug}.html`} draggable="true">
		<video muted loop playsinline preload="none" poster={`/posters/${slug}.webp`} aria-hidden="true" data-play-hover>
			<source src={`/previews/${slug}.webm`} type="video/webm" />
		</video>
		<span class="tile-shade" aria-hidden="true"></span>
		<span class="tile-copy">
			<span class="tile-title">{title}</span>
			<span class="tile-tagline">{tagline}</span>
		</span>
	</a>
	<button class="tile-use" type="button" aria-label={`Use ${title} in Studio`}>Use</button>
</div>
