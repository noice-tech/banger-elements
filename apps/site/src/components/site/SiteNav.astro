---
import {elementCategories, elements} from '../../data/elements';

interface Props {
	class?: string;
	label: string;
}
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const activeCategory =
	elementCategories.find((category) => current === `/${category.id}`)?.id ??
	elements.find((entry) => current === `/${entry.slug}`)?.category;
const links = [
	...elementCategories.map((category) => ({
		href: `/${category.id}`,
		label: category.title,
		active: activeCategory === category.id,
	})),
	{href: '/examples.html', label: 'Examples', active: current === '/examples'},
	{href: '/getting-started.html', label: 'Docs', active: current === '/getting-started'},
];
---
<nav class={Astro.props.class} aria-label={Astro.props.label}>
	{links.map((link) => (
		<a href={link.href} aria-current={link.active ? 'page' : undefined}>
			{link.label}
		</a>
	))}
	<slot />
</nav>
