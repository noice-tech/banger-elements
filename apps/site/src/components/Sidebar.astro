---
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import {elements, elementCategories} from '../data/elements';
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === href.replace(/\.html$/, '');
---
<nav class="docs-nav" aria-label="Docs">
	<p class="docs-nav-label">Docs</p>
	<a href="/getting-started.html" aria-current={isCurrent('/getting-started') ? 'page' : undefined}>Getting started</a>
	<a href="/examples.html" aria-current={isCurrent('/examples') ? 'page' : undefined}>Examples</a>
	<p class="docs-nav-label">Collection</p>
	{elementCategories.map((category) => (
		<a href={`/${category.id}`}>
			{category.title}
			<span>{elements.filter((entry) => entry.category === category.id).length}</span>
		</a>
	))}
	<p class="docs-nav-label">Elsewhere</p>
	<a href="https://github.com/noice-tech/banger-elements">GitHub</a>
	<a href="https://banger.show/">banger.show</a>
</nav>
<div class="md:sl-hidden"><MobileMenuFooter /></div>
