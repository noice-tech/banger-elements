---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {elements, elementCategories} from '../data/elements';
interface Props { category?: typeof elementCategories[number]['id'] }
const {category: selectedCategory} = Astro.props;
const activeCategory = elementCategories.find(category => category.id === selectedCategory);
const pageTitle = activeCategory ? `${activeCategory.title} for Remotion` : 'Give your sound a shape.';
const description = activeCategory ? `${activeCategory.description} Explore open-source ${activeCategory.title.toLowerCase()} for Remotion, preview and customize each element, and use the source in your project.` : `${elements.length} source-installable visualizers, shaders and effects for Remotion.`;
const categories = activeCategory ? [activeCategory] : elementCategories;
const canonical = new URL(activeCategory ? `/${activeCategory.id}` : '/', Astro.site).href;
---
<StarlightPage frontmatter={{title: pageTitle, description, tableOfContents: false, head: [
	{tag: 'link', attrs: {rel: 'canonical', href: canonical}},
	{tag: 'meta', attrs: {property: 'og:url', content: canonical}},
]}}>
	<div class="collection-page not-content">
		<header class="collection-hero">
			{activeCategory ? <>
				<h1 id="_top">{activeCategory.title}<br /><span>for Remotion.</span></h1>
				<p class="hero-description">{activeCategory.description}<br class="desktop-break" /> Preview, customize, and make the source your own.</p>
			</> : <>
				<h1 id="_top">Give your sound<br /><span>a shape.</span></h1>
				<p class="hero-description">Visualizers, shaders and effects for Remotion.<br class="desktop-break" /> Find your look, tune the details, and make the source your own.</p>
			</>}
			<div class="hero-links"><a class="button primary" href="#collection">Explore the collection <span aria-hidden="true">↓</span></a><a class="text-link" href="/getting-started.html">How it works <span aria-hidden="true">↗</span></a></div>
			<div class="hero-meta"><span>Open source</span><span>Audio-reactive</span><span>Made for Remotion</span></div>
		</header>
		<div class="collection-toolbar" id="collection">
			<nav class="collection-filters" aria-label="Filter collection">
				<a href="/#collection" data-category="all" aria-current={!activeCategory ? 'page' : undefined}>All <span>{elements.length}</span></a>
				{elementCategories.map(category => <a href={`/${category.id}`} data-category={category.id} aria-current={selectedCategory === category.id ? 'page' : undefined}>{category.title} <span>{elements.filter(entry => entry.category === category.id).length}</span></a>)}
			</nav>
		</div>
		<p class="collection-status sr-only" role="status" aria-live="polite"></p>
		{categories.map(category => {
			const entries = elements.filter(entry => entry.category === category.id);
			const featured: readonly string[] = category.featured;
			const ordered = [...entries].sort((a, b) => {
				const rank = (slug: string) => featured.includes(slug) ? featured.indexOf(slug) : featured.length;
				return rank(a.slug) - rank(b.slug);
			});
			return <section class="collection-category" data-section={category.id} aria-labelledby={category.id}>
				<header class="category-heading">
					<div class="category-eyebrow" id={category.id} role="heading" aria-level="3">{category.title}<span class="collection-count">{entries.length}</span></div>
					<p>{category.description}</p>
				</header>
				<div class="element-grid">
					{ordered.map(entry => <a class="element-card" href={`/${entry.slug}.html`} data-search={`${entry.title} ${entry.tagline} ${entry.description}`.toLowerCase()} data-featured={featured.includes(entry.slug) ? 'true' : 'false'}>
						<div class="card-art">
							<video muted loop playsinline preload="none" poster={`/posters/${entry.slug}.webp`} aria-hidden="true"><source src={`/previews/${entry.slug}.webm`} type="video/webm" /></video>
							<span class="card-open" aria-hidden="true">↗</span>
						</div>
						<div class="card-copy"><div class="card-title"><h4>{entry.title}</h4><span class="renderer-label">{entry.renderer}</span></div><p>{entry.tagline}</p></div>
					</a>)}
				</div>
				<a class="category-view-all text-link" href={`/${category.id}`} data-category={category.id} hidden={!!activeCategory}>View all {entries.length} {category.title.toLowerCase()} <span aria-hidden="true">→</span></a>
			</section>;
		})}
		<div class="collection-empty" hidden><h3>No matching elements.</h3><p>Try another search or choose a different category.</p><button class="button" type="button">Clear search</button></div>
	</div>
</StarlightPage>
<script>
	const search = document.querySelector<HTMLInputElement>('.collection-search input');
	const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'));
	const filters = Array.from(document.querySelectorAll<HTMLAnchorElement>('.collection-filters a'));
	const status = document.querySelector<HTMLElement>('.collection-status')!;
	const empty = document.querySelector<HTMLElement>('.collection-empty')!;
	const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.card-art video'));
	const visible = new Set<HTMLVideoElement>();
	const category = filters.find(link => link.getAttribute('aria-current') === 'page')?.dataset.category ?? 'all';
	const sync = () => videos.forEach(video => {
		if (!motion.matches && !document.hidden && visible.has(video) && !video.closest('[hidden]')) {
			void video.play().catch(() => { /* Keep the poster if playback is unavailable. */ });
		} else video.pause();
	});
	const render = () => {
		const query = (search?.value ?? '').trim().toLowerCase();
		const overview = category === 'all' && !query;
		let count = 0;
		sections.forEach(section => {
			const selected = category === 'all' || category === section.dataset.section;
			let matches = 0;
			section.querySelectorAll<HTMLElement>('.element-card').forEach(card => {
				const match = selected && (card.dataset.search ?? '').includes(query);
				card.hidden = !match || (overview && card.dataset.featured !== 'true');
				if (!card.hidden) matches++;
			});
			section.hidden = matches === 0;
			section.querySelector<HTMLElement>('.category-view-all')!.hidden = !overview;
			count += matches;
		});
		empty.hidden = count > 0;
		status.textContent = overview ? `Showing ${count} featured elements. Choose a category to see all.` : `${count} matching ${count === 1 ? 'element' : 'elements'}.`;
		sync();
	};
	const restore = () => {
		const params = new URLSearchParams(location.search);
		if (search) search.value = params.get('q') ?? '';
		render();
	};
	const save = () => {
		if (!search) return;
		const url = new URL(location.href);
		if (search.value.trim()) url.searchParams.set('q', search.value.trim());
		else url.searchParams.delete('q');
		history.replaceState(null, '', url);
		render();
	};
	search?.addEventListener('input', save);
	empty.querySelector('button')!.addEventListener('click', () => {
		if (search) search.value = '';
		save();
		search?.focus();
	});
	window.addEventListener('popstate', restore);
	window.addEventListener('pageshow', restore);
	const searchContainer = document.querySelector<HTMLElement>('.collection-search');
	if (searchContainer) searchContainer.hidden = false;
	restore();
	const observer = new IntersectionObserver(entries => {
		entries.forEach(entry => {
			const video = entry.target as HTMLVideoElement;
			if (entry.isIntersecting) visible.add(video);
			else visible.delete(video);
		});
		sync();
	}, {threshold: 0.15});
	videos.forEach(video => observer.observe(video));
	motion.addEventListener('change', sync);
	document.addEventListener('visibilitychange', sync);
</script>
