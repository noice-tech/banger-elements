---
import ElementTile from './site/ElementTile.astro';
import {elements, elementCategories} from '../data/elements';

interface Props {
	category?: (typeof elementCategories)[number]['id'];
}
const {category: selectedCategory} = Astro.props;
const all = !selectedCategory;
const categories = all ? elementCategories : elementCategories.filter((category) => category.id === selectedCategory);
const tabs = [
	{href: '/', title: 'All', current: all},
	...elementCategories.map((category) => ({
		href: `/${category.id}`,
		title: category.title,
		current: selectedCategory === category.id,
	})),
];
---
<div class="collection">
	<div class="collection-toolbar">
		<nav class="collection-filters" aria-label="Categories">
			{tabs.map((tab) => (
				<a href={tab.href} aria-current={tab.current ? 'page' : undefined}>
					{tab.title}
				</a>
			))}
		</nav>
		<label class="collection-search">
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
			<span class="sr-only">Filter elements</span>
			<input type="search" placeholder="Filter by name or mood" autocomplete="off" />
		</label>
	</div>
	<p class="collection-status sr-only" role="status" aria-live="polite"></p>
	{categories.map((category) => {
		const entries = elements.filter((entry) => entry.category === category.id);
		const featured: readonly string[] = category.featured;
		const rank = (slug: string) => (featured.includes(slug) ? featured.indexOf(slug) : featured.length);
		const ordered = [...entries].sort((a, b) => rank(a.slug) - rank(b.slug));
		return (
			<section class="collection-category" data-section={category.id} aria-labelledby={category.id}>
				{all ? (
					<h2 id={category.id} class="category-heading">{category.title}</h2>
				) : (
					<h2 id={category.id} class="sr-only">{category.title}</h2>
				)}
				<div class="collection-grid">
					{ordered.map((entry) => (
						<ElementTile
							slug={entry.slug}
							title={entry.title}
							tagline={entry.tagline}
							description={entry.description}
						/>
					))}
				</div>
			</section>
		);
	})}
	<div class="collection-empty" hidden>
		<p class="collection-empty-title">Nothing matches that.</p>
		<p>Try another word, or browse a different category.</p>
		<button class="button" type="button">Clear filter</button>
	</div>
	<p class="studio-toast" role="status" aria-live="polite" hidden></p>
</div>
<script>
	import {installInStudio, setStudioDragData, type StudioElementPayload} from '@remotion/studio-protocol';
	import {nextStep} from './studio-messages';

	const payloads = new Map<string, Promise<StudioElementPayload>>();
	const loaded = new Map<string, StudioElementPayload>();
	const payloadFor = (slug: string) => {
		let request = payloads.get(slug);
		if (!request) {
			request = fetch(`/elements/${slug}.json`).then(async (response) => {
				if (!response.ok) throw new Error(`Could not load ${slug} (${response.status}). Reload to retry.`);
				const {type, version, element} = (await response.json()) as StudioElementPayload;
				const payload = {type, version, element} as StudioElementPayload;
				loaded.set(slug, payload);
				return payload;
			});
			request.catch(() => payloads.delete(slug));
			payloads.set(slug, request);
		}
		return request;
	};
	const toast = document.querySelector<HTMLElement>('.studio-toast');
	let toastTimer = 0;
	const announce = (message: string) => {
		if (!toast) return;
		toast.textContent = message;
		toast.hidden = false;
		clearTimeout(toastTimer);
		toastTimer = window.setTimeout(() => (toast.hidden = true), 6000);
	};
	for (const item of document.querySelectorAll<HTMLElement>('.tile-item')) {
		const slug = item.dataset.slug!;
		const title = item.querySelector('.tile-title')!.textContent;
		const use = item.querySelector<HTMLButtonElement>('.tile-use')!;
		const tile = item.querySelector<HTMLAnchorElement>('.tile')!;
		item.addEventListener('pointerenter', () => void payloadFor(slug).catch(() => {}));
		item.addEventListener('focusin', () => void payloadFor(slug).catch(() => {}));
		tile.addEventListener('dragstart', (event) => {
			const payload = loaded.get(slug);
			if (!payload || !event.dataTransfer) return;
			setStudioDragData({dataTransfer: event.dataTransfer, payload});
		});
		use.addEventListener('click', async () => {
			use.disabled = true;
			use.setAttribute('aria-busy', 'true');
			announce(`Sending ${title} to Remotion Studio…`);
			try {
				const result = await installInStudio({payload: await payloadFor(slug)});
				use.textContent = result.success ? 'Sent' : 'Use';
				announce(
					result.success
						? `Confirm ${title} in ${result.target.studioOrigin} to finish installing it.`
						: (nextStep[result.code] ?? `${result.message} Try again, or open the element to download its TSX.`),
				);
			} catch (error) {
				announce(error instanceof Error ? error.message : String(error));
			} finally {
				use.disabled = false;
				use.removeAttribute('aria-busy');
			}
		});
	}

	const root = document.querySelector<HTMLElement>('.collection');
	const search = root?.querySelector<HTMLInputElement>('.collection-search input');
	if (root && search) {
		const grids = Array.from(root.querySelectorAll<HTMLElement>('.collection-grid'));
		const status = root.querySelector<HTMLElement>('.collection-status')!;
		const empty = root.querySelector<HTMLElement>('.collection-empty')!;
		const render = () => {
			const query = search.value.trim().toLowerCase();
			let count = 0;
			for (const grid of grids) {
				let matches = 0;
				for (const tile of grid.querySelectorAll<HTMLElement>('.tile-item')) {
					tile.hidden = !(tile.dataset.search ?? '').includes(query);
					if (!tile.hidden) matches++;
				}
				grid.closest<HTMLElement>('.collection-category')!.hidden = matches === 0;
				count += matches;
			}
			empty.hidden = count > 0;
			status.textContent = query ? `${count} matching ${count === 1 ? 'element' : 'elements'}.` : '';
			document.dispatchEvent(new Event('showcase:sync-media'));
		};
		const restore = () => {
			search.value = new URLSearchParams(location.search).get('q') ?? '';
			render();
		};
		search.addEventListener('input', () => {
			const url = new URL(location.href);
			if (search.value.trim()) url.searchParams.set('q', search.value.trim());
			else url.searchParams.delete('q');
			history.replaceState(null, '', url);
			render();
		});
		empty.querySelector('button')!.addEventListener('click', () => {
			search.value = '';
			search.dispatchEvent(new Event('input'));
			search.focus();
		});
		window.addEventListener('pageshow', restore);
		restore();
	}
</script>
