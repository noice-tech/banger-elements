{
	"name": "@banger-elements/site",
	"version": "0.5.0",
	"private": true,
	"description": "Showcase and documentation for Banger Elements.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noice-tech/banger-elements.git",
		"directory": "apps/site"
	},
	"type": "module",
	"scripts": {
		"build": "tsx scripts/build.ts",
		"serve": "astro preview",
		"typecheck": "astro check && tsc --noEmit",
		"posters": "node scripts/posters.mjs && node scripts/poster-sizes.mjs",
		"previews": "node scripts/previews.mjs",
		"clips": "node scripts/clips.mjs",
		"poster-sizes": "node scripts/poster-sizes.mjs",
		"hero-word": "node scripts/hero-word.mjs",
		"reel": "node scripts/reel.mjs",
		"recipes": "node scripts/recipes.mjs",
		"scenes": "node scripts/scenes.mjs",
		"test": "tsx --test tests/*.test.ts",
		"wrap": "node scripts/wrap.mjs",
		"share-images": "node scripts/share-images.mjs"
	},
	"dependencies": {
		"@astrojs/react": "7.1.9",
		"@astrojs/starlight": "0.43.1",
		"@remotion/media": "4.0.547",
		"@remotion/media-utils": "4.0.547",
		"@remotion/player": "4.0.547",
		"@remotion/studio-protocol": "4.0.547",
		"astro": "7.4.12",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"remotion": "4.0.547"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@banger-elements/collection": "workspace:*",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"sharp": "0.35.5",
		"tsx": "4.23.15",
		"typescript": "6.0.3"
	}
}
