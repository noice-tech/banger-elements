{
	"name": "banger-elements",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.8",
	"engines": {
		"node": "24.18.1",
		"bun": "1.3.8"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build:elements": "node scripts/turbo.mjs run build --filter=@banger-elements/collection",
		"build": "node scripts/turbo.mjs run build",
		"dev": "node scripts/turbo.mjs run serve studio",
		"site": "node scripts/turbo.mjs run serve --filter=@banger-elements/site",
		"studio": "node scripts/turbo.mjs run studio --filter=@banger-elements/studio",
		"format": "oxfmt --ignore-path=.oxfmtignore .",
		"format:check": "oxfmt --check --ignore-path=.oxfmtignore .",
		"lint": "eslint .",
		"typecheck": "node scripts/turbo.mjs run typecheck",
		"test": "node scripts/turbo.mjs run test",
		"check": "oxfmt --check --ignore-path=.oxfmtignore . && eslint . && node scripts/turbo.mjs run typecheck test",
		"smoke": "node scripts/turbo.mjs run smoke --filter=@banger-elements/studio",
		"render": "node scripts/turbo.mjs run render --filter=@banger-elements/studio",
		"previews": "node scripts/turbo.mjs run previews --filter=@banger-elements/site",
		"clean": "node scripts/clean.mjs"
	},
	"devDependencies": {
		"@remotion/cli": "4.0.520",
		"@remotion/eslint-config-flat": "4.0.520",
		"@types/node": "22.18.0",
		"eslint": "9.39.1",
		"globals": "16.5.0",
		"oxfmt": "0.66.0",
		"turbo": "2.10.12",
		"typescript": "5.9.2"
	}
}
