{
	"name": "banger-elements",
	"version": "0.5.0",
	"private": true,
	"description": "Audio-reactive elements for Remotion.",
	"license": "MIT",
	"author": "Noice Tech",
	"homepage": "https://github.com/noice-tech/banger-elements#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noice-tech/banger-elements.git"
	},
	"bugs": {
		"url": "https://github.com/noice-tech/banger-elements/issues"
	},
	"type": "module",
	"packageManager": "bun@1.3.8",
	"engines": {
		"node": "24.22.3",
		"bun": "1.3.8"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"tools/*"
	],
	"scripts": {
		"build:elements": "node scripts/turbo.mjs run build --filter=@banger-elements/collection",
		"build": "node scripts/turbo.mjs run build",
		"dev": "node scripts/turbo.mjs run serve studio",
		"site": "node scripts/turbo.mjs run serve --filter=@banger-elements/site",
		"studio": "node scripts/turbo.mjs run studio --filter=@banger-elements/studio",
		"format": "oxfmt --ignore-path=.oxfmtignore .",
		"format:check": "oxfmt --check --ignore-path=.oxfmtignore .",
		"lint": "oxlint && knip --no-progress",
		"typecheck": "node scripts/turbo.mjs run typecheck",
		"test": "node scripts/turbo.mjs run test",
		"check": "oxfmt --check --ignore-path=.oxfmtignore . && oxlint && knip --no-progress && node scripts/turbo.mjs run typecheck test",
		"smoke": "node scripts/turbo.mjs run smoke --filter=@banger-elements/studio",
		"render": "node scripts/turbo.mjs run render --filter=@banger-elements/studio",
		"previews": "node scripts/turbo.mjs run previews --filter=@banger-elements/site",
		"clean": "node scripts/clean.mjs"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.79.0",
		"@remotion/cli": "4.0.547",
		"@remotion/eslint-plugin": "4.0.547",
		"@types/node": "24.19.2",
		"knip": "6.48.0",
		"oxfmt": "0.79.0",
		"oxlint": "1.79.0",
		"turbo": "2.11.11",
		"typescript": "6.0.3"
	}
}
