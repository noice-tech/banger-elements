{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".node-version", "tsconfig.base.json", "bun.lock"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/NOTICE.md"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/NOTICE.md"],
			"outputs": []
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"studio": {
			"cache": false,
			"persistent": true
		},
		"serve": {
			"cache": false,
			"persistent": true
		},
		"smoke": {"cache": false},
		"render": {"cache": false}
	}
}
